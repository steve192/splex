{
  "name": "splex-frontend",
  "version": "2.7.1",
  "private": true,
  "license": "Splex Non-Commercial Source License 1.0",
  "author": "steve192",
  "homepage": "https://github.com/steve192/splex",
  "repository": {
    "type": "git",
    "url": "https://github.com/steve192/splex.git"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start --tunnel",
    "android": "expo start --tunnel --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo prebuild",
    "build:web": "expo export --platform web --output-dir dist",
    "build-web": "npm run build:web",
    "publish-expo-production": "npx -p eas-cli eas update --branch production --platform android --auto",
    "publish-expo-preview": "npx -p eas-cli eas update --branch preview --platform android --auto",
    "publish-preview": "npx -p eas-cli eas update --branch preview --platform android --auto",
    "build-android": "npx -p eas-cli eas build --platform android --profile production",
    "build-android-apk": "npx -p eas-cli eas build --platform android --profile production-apk",
    "build-android-dev": "npx -p eas-cli eas build --platform android --profile development",
    "build-android-preview": "npx -p eas-cli eas build --platform android --profile preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:leaflet-assets": "node scripts/build-leaflet-assets.js",
    "build:pwa-icons": "node scripts/build-pwa-icons.js",
    "postinstall": "node scripts/build-leaflet-assets.js && node scripts/build-pwa-icons.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.15",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.18.17",
    "@react-navigation/native": "7.3.17",
    "@react-navigation/native-stack": "7.18.9",
    "expo": "57.0.19",
    "expo-application": "57.0.2",
    "expo-auth-session": "57.0.11",
    "expo-clipboard": "57.0.1",
    "expo-constants": "57.0.17",
    "expo-crypto": "57.0.2",
    "expo-dev-client": "57.0.18",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.6",
    "expo-font": "57.0.3",
    "expo-image-manipulator": "57.0.15",
    "expo-image-picker": "57.0.15",
    "expo-intent-launcher": "57.0.1",
    "expo-linear-gradient": "57.0.1",
    "expo-linking": "57.0.9",
    "expo-localization": "57.0.1",
    "expo-location": "57.0.15",
    "expo-notifications": "57.0.16",
    "expo-sharing": "57.0.17",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.3",
    "expo-updates": "57.0.21",
    "expo-web-browser": "57.0.2",
    "leaflet": "1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-gifted-charts": "1.4.78",
    "react-native-paper": "5.15.3",
    "react-native-paper-dates": "0.23.16",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/react": "19.2.15",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
