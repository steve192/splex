{
  "name": "splex-frontend",
  "version": "2.8.7",
  "private": true,
  "license": "Splex Non-Commercial Source License 1.0",
  "author": "steve192",
  "homepage": "https://github.com/steve192/splex",
  "repository": {
    "type": "git",
    "url": "https://github.com/steve192/splex.git"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start --tunnel",
    "android": "expo start --tunnel --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo prebuild",
    "build:web": "expo export --platform web --output-dir dist",
    "build-web": "npm run build:web",
    "publish-expo-production": "npx -p eas-cli eas update --branch production --platform android --auto",
    "publish-expo-preview": "npx -p eas-cli eas update --branch preview --platform android --auto",
    "publish-preview": "npx -p eas-cli eas update --branch preview --platform android --auto",
    "build-android": "npx -p eas-cli eas build --platform android --profile production",
    "build-android-apk": "npx -p eas-cli eas build --platform android --profile production-apk",
    "build-android-dev": "npx -p eas-cli eas build --platform android --profile development",
    "build-android-preview": "npx -p eas-cli eas build --platform android --profile preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:web": "playwright test",
    "build:leaflet-assets": "node scripts/build-leaflet-assets.js",
    "build:pwa-icons": "node scripts/build-pwa-icons.js",
    "postinstall": "node scripts/build-leaflet-assets.js && node scripts/build-pwa-icons.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "58.0.25",
    "expo-application": "58.1.2",
    "expo-auth-session": "58.0.18",
    "expo-build-properties": "58.0.12",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-dev-client": "58.0.20",
    "expo-document-picker": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.12",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-intent-launcher": "58.0.3",
    "expo-linear-gradient": "58.0.4",
    "expo-linking": "58.0.17",
    "expo-localization": "58.0.5",
    "expo-location": "58.0.22",
    "expo-notifications": "58.1.9",
    "expo-sharing": "58.0.23",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-updates": "58.0.22",
    "expo-web-browser": "58.0.8",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-gifted-charts": "1.4.81",
    "react-native-paper": "5.15.4",
    "react-native-paper-dates": "0.24.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
